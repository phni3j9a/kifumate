{
  "cli": {
    "version": ">= 27.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ANALYSIS_URL": "https://kifumate-analysis-staging.yuki-nakano-1020.workers.dev",
        "APP_VARIANT": "development"
      },
      "autoIncrement": true
    },
    "apk": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ANALYSIS_URL": "https://kifumate-api.quarterlambda.com",
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "production": {
      "extends": "apk",
      "android": {
        "buildType": "app-bundle"
      },
      "distribution": "store"
    }
  }
}
