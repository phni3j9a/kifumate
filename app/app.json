{
  "expo": {
    "name": "kifumate",
    "slug": "kifumate",
    "scheme": "kifumate",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/app-icon.webp",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker",
      "expo-sharing"
    ],
    "android": { "package": "jp.kifumate.app" },
    "ios": { "bundleIdentifier": "jp.kifumate.app", "supportsTablet": true },
    "web": { "bundler": "metro", "output": "single", "name": "kifumate" }
  }
}
