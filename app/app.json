{
  "expo": {
    "name": "kifumate",
    "slug": "kifumate",
    "scheme": "kifumate",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/app-icon.png",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker",
      "expo-sharing",
      "expo-font",
      "expo-secure-store"
    ],
    "android": {
      "package": "com.quarterlambda.kifumate"
    },
    "ios": {
      "bundleIdentifier": "com.quarterlambda.kifumate",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "kifumate"
    }
  }
}
