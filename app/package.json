{
  "name": "kifumate",
  "version": "1.0.0",
  "description": "将棋の棋譜を端末内で記録・再生するアプリ",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts && node scripts/check-product-names.mjs",
    "test:web": "playwright test",
    "check": "npm run test && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "encoding-japanese": "^2.5.0",
    "expo": "^58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "tsshogi": "^2.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true
}
