{
  "name": "kifumate",
  "version": "0.1.0",
  "description": "将棋の棋譜を端末内で記録・再生するアプリ",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "web": "expo start --go --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "tsx --test tests/*.test.ts && node scripts/check-product-names.mjs",
    "test:web": "playwright test",
    "check": "npm run test && npm run typecheck && npm run lint",
    "compare": "tsx scripts/compare-mock.mts",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "build:android": "bash scripts/build-android-release.sh"
  },
  "dependencies": {
    "@expo-google-fonts/zen-maru-gothic": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "encoding-japanese": "^2.5.0",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "tsshogi": "^2.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.23.0"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    }
  }
}
