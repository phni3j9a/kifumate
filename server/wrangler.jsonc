{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kifumate-analysis",
  "account_id": "0c28583a22fe4051144d6efdb783d3b0",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {"ENVIRONMENT": "local", "ALLOW_DEV_PAID": "false", "PAUSE_FREE_ANALYSIS": "false", "REALTIME_IDLE_MS": "30000", "REALTIME_HOLD_IDLE_MS": "300000", "COACH_WEEKLY_BUDGET_USD": "0.5", "COACH_MAX_TOKENS": "32768", "COACH_TIMEOUT_MS": "240000"},
  "durable_objects": {
    "bindings": [
      {"name": "DEVICES", "class_name": "Device"},
      {"name": "STD", "class_name": "StandardContainer"},
      {"name": "PRECISE", "class_name": "PreciseContainer"},
      {"name": "REALTIME", "class_name": "RealtimeContainer"},
      {"name": "STD_JOB", "class_name": "StandardJob"},
      {"name": "PRECISE_JOB", "class_name": "PreciseJob"},
      {"name": "RT_ENGINE", "class_name": "RealtimeEngine"},
      {"name": "RT_ACCOUNTS", "class_name": "RealtimeAccount"},
      {"name": "INVITATIONS", "class_name": "Invitations"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["Device", "StandardContainer", "PreciseContainer"]},
    {"tag": "v2", "new_sqlite_classes": ["RealtimeContainer"]},
    {"tag": "v3", "new_sqlite_classes": ["Invitations"]},
    {"tag": "v4", "new_sqlite_classes": ["StandardJob", "PreciseJob", "RealtimeEngine", "RealtimeAccount"]}
  ],
  "containers": [
    {"class_name": "StandardContainer", "image": "./container/Dockerfile", "instance_type": "standard-2", "max_instances": 2},
    {"class_name": "PreciseContainer", "image": "./container/Dockerfile", "instance_type": "standard-3", "max_instances": 2},
    {"class_name": "RealtimeContainer", "image": "./container/Dockerfile", "instance_type": "standard-2", "max_instances": 2},
    {"class_name": "StandardJob", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile"}}},
    {"class_name": "PreciseJob", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile"}}},
    {"class_name": "RealtimeEngine", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile"}}}
  ],
  "env": {
    "staging": {
      "name": "kifumate-analysis-staging",
      "vars": {"ENVIRONMENT": "staging", "ALLOW_DEV_PAID": "true", "PAUSE_FREE_ANALYSIS": "false", "REALTIME_IDLE_MS": "30000", "REALTIME_HOLD_IDLE_MS": "300000", "COACH_WEEKLY_BUDGET_USD": "0.5", "COACH_MAX_TOKENS": "5400", "COACH_TIMEOUT_MS": "240000", "COACH_PROVIDER": "openai-responses-tools", "COACH_BASE_URL": "https://api.openai.com/v1", "COACH_MODEL": "gpt-6.1-terra", "COACH_PRICES_USD_PER_MILLION": "{\"openai-responses-tools/gpt-6.1-terra\":{\"input\":1,\"cacheRead\":0.05,\"cacheWrite\":2.5,\"output\":5}}", "COACH_REASONING_EFFORT": "high"},
      "durable_objects": {
        "bindings": [
          {"name": "DEVICES", "class_name": "Device"},
          {"name": "STD", "class_name": "StandardContainer"},
          {"name": "PRECISE", "class_name": "PreciseContainer"},
          {"name": "REALTIME", "class_name": "RealtimeContainer"},
          {"name": "STD_JOB", "class_name": "StandardJob"},
          {"name": "PRECISE_JOB", "class_name": "PreciseJob"},
          {"name": "RT_ENGINE", "class_name": "RealtimeEngine"},
          {"name": "RT_ACCOUNTS", "class_name": "RealtimeAccount"},
          {"name": "INVITATIONS", "class_name": "Invitations"}
        ]
      },
      "containers": [
        {"class_name": "StandardContainer", "image": "./container/Dockerfile", "instance_type": "standard-2", "max_instances": 2},
        {"class_name": "PreciseContainer", "image": "./container/Dockerfile", "instance_type": "standard-3", "max_instances": 2},
        {"class_name": "RealtimeContainer", "image": "./container/Dockerfile", "instance_type": "standard-2", "max_instances": 2},
        {"class_name": "StandardJob", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile"}}},
        {"class_name": "PreciseJob", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile"}}},
        {"class_name": "RealtimeEngine", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile"}}}
      ],
      "ratelimits": [
        {"name": "REGISTRATION_LIMITER", "namespace_id": "24010", "simple": {"limit": 10, "period": 60}},
        {"name": "API_LIMITER", "namespace_id": "24011", "simple": {"limit": 300, "period": 60}},
        {"name": "WRITE_LIMITER", "namespace_id": "24012", "simple": {"limit": 60, "period": 60}},
        {"name": "INVITE_LIMITER", "namespace_id": "24013", "simple": {"limit": 5, "period": 60}}
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1
        }
      }
    },
    "production": {
      "name": "kifumate-analysis-production",
      "vars": {"ENVIRONMENT": "production", "ANALYSIS_DRAIN": "false", "PAUSE_FREE_ANALYSIS": "false", "ALLOW_DEV_PAID": "false", "REALTIME_IDLE_MS": "30000", "REALTIME_HOLD_IDLE_MS": "300000", "COACH_WEEKLY_BUDGET_USD": "0.5", "COACH_MAX_TOKENS": "5400", "COACH_TIMEOUT_MS": "240000", "COACH_PROVIDER": "openai-responses-tools", "COACH_BASE_URL": "https://api.openai.com/v1", "COACH_MODEL": "gpt-6.1-terra", "COACH_PRICES_USD_PER_MILLION": "{\"openai-responses-tools/gpt-6.1-terra\":{\"input\":1,\"cacheRead\":0.05,\"cacheWrite\":2.5,\"output\":5}}", "COACH_REASONING_EFFORT": "high"},
      "durable_objects": {
        "bindings": [
          {"name": "DEVICES", "class_name": "Device"},
          {"name": "STD", "class_name": "StandardContainer"},
          {"name": "PRECISE", "class_name": "PreciseContainer"},
          {"name": "REALTIME", "class_name": "RealtimeContainer"},
          {"name": "STD_JOB", "class_name": "StandardJob"},
          {"name": "PRECISE_JOB", "class_name": "PreciseJob"},
          {"name": "RT_ENGINE", "class_name": "RealtimeEngine"},
          {"name": "RT_ACCOUNTS", "class_name": "RealtimeAccount"},
          {"name": "INVITATIONS", "class_name": "Invitations"}
        ]
      },
      "containers": [
        {"class_name": "StandardContainer", "image": "./container/Dockerfile", "instance_type": "standard-2", "max_instances": 2},
        {"class_name": "PreciseContainer", "image": "./container/Dockerfile", "instance_type": "standard-3", "max_instances": 2},
        {"class_name": "RealtimeContainer", "image": "./container/Dockerfile", "instance_type": "standard-2", "max_instances": 2},
        {"class_name": "StandardJob", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile"}}},
        {"class_name": "PreciseJob", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile"}}},
        {"class_name": "RealtimeEngine", "scheduling_policy": "durable_object", "images": {"base": {"dockerfile": "./container/Dockerfile"}}}
      ],
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {"pattern": "kifumate-api.quarterlambda.com", "custom_domain": true}
      ],
      "ratelimits": [
        {"name": "REGISTRATION_LIMITER", "namespace_id": "24020", "simple": {"limit": 10, "period": 60}},
        {"name": "API_LIMITER", "namespace_id": "24021", "simple": {"limit": 300, "period": 60}},
        {"name": "WRITE_LIMITER", "namespace_id": "24022", "simple": {"limit": 60, "period": 60}},
        {"name": "INVITE_LIMITER", "namespace_id": "24023", "simple": {"limit": 5, "period": 60}}
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1
        }
      }
    }
  },
  "ratelimits": [
    {"name": "REGISTRATION_LIMITER", "namespace_id": "24000", "simple": {"limit": 10, "period": 60}},
    {"name": "API_LIMITER", "namespace_id": "24001", "simple": {"limit": 300, "period": 60}},
    {"name": "WRITE_LIMITER", "namespace_id": "24002", "simple": {"limit": 60, "period": 60}},
    {"name": "INVITE_LIMITER", "namespace_id": "24003", "simple": {"limit": 5, "period": 60}}
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}
